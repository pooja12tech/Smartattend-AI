# ==============================================================================
# SmartAttend-AI Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Database (Neon PostgreSQL) - REQUIRED FOR POSTGRES MIGRATION
# ------------------------------------------------------------------------------
# Obtain from your Neon Console (Dashboard -> Connection Details -> Pooled connection)
# Example syntax:
# DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require


# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Device Binding & Hardware Lock (Set to true in production, false during testing)
DEVICE_BINDING_ENABLED=false

# ------------------------------------------------------------------------------
# 4. Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 32 url-safe base64-encoded bytes (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FACE_EMBED_KEY=replace_with_a_fernet_key_or_32_char_passphrase

# ------------------------------------------------------------------------------
# 5. CORS Origins
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
